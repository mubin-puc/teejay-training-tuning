GO

CREATE   PROCEDURE [acct].[GetEventReservationsForFamilyCalendar](
    @accountId INT,
    @fromDate DATE,
    @toDate DATE,
    @personId INT = NULL,
    @onlyActivePending BIT
)
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @now DATETIMEOFFSET = SYSDATETIMEOFFSET();

    /* CORE-332: the [Subscription.Person.Subscriptions] correlated subquery depends only on
       (per.Id, p.Id) but was re-evaluated once per reservation row (e.g. 883 rows over just 2
       distinct PersonId/ParkId pairs = ~104K of 163K total logical reads across Subscription /
       ParkProduct / ProductTemplate). Resolve the in-scope (PersonId, ParkId) pairs once, then
       materialize the other-active-Subscription ids per pair into an indexed #temp, and filter
       the current subscription out (os.Id <> s.Id) at projection time. */
    SELECT DISTINCT
        s.PersonId,
        p.Id AS ParkId,
        p.Timezone
    INTO #personPark
    FROM acct.Subscription s
    JOIN events.EventReservations er
        ON er.SubscriptionId = s.Id
    JOIN events.FranchiseScheduleDetails fsd
        ON fsd.Id = er.FranchiseScheduleDetailId
    JOIN events.FranchiseSchedules fs
        ON fsd.FranchiseScheduleId = fs.Id
    JOIN park.Park p
        ON fs.ParkId = p.Id
    WHERE s.AccountId = @accountId;

    SELECT
        pp.PersonId,
        pp.ParkId,
        os.Id AS OtherSubscriptionId
    INTO #otherSubs
    FROM #personPark pp
    JOIN acct.Subscription os
        ON os.PersonId = pp.PersonId
    JOIN prdct.ParkProduct opp
        ON opp.Id = os.ProductId
        AND opp.ParkId = pp.ParkId
    JOIN prdct.ProductTemplate opt
        ON opt.Id = opp.ProductTemplateId
        AND opt.ProductTypeId IN (1, 7) /* Membership, Annual Pass */
    WHERE os.SubscriptionStatusId IN (0, 100, 200, 400, 900, 1000) /* Inactive, Pending, Active, Paused, PastDue, Presales */
        AND os.ExpirationDate > (@now AT TIME ZONE pp.Timezone)
    GROUP BY pp.PersonId, pp.ParkId, os.Id;

    CREATE CLUSTERED INDEX IX_otherSubs ON #otherSubs (PersonId, ParkId, OtherSubscriptionId);

    SELECT CONVERT(NVARCHAR(MAX), (
        SELECT
            fsd.Id [FranchiseScheduleDetail.Id],
            fsd.StartDate [FranchiseScheduleDetail.StartDate],
            fsd.EndDate [FranchiseScheduleDetail.EndDate],
            fsd.DayMask [FranchiseScheduleDetail.DayMask],
            fsd.StartTime [FranchiseScheduleDetail.StartTime],
            fsd.EndTime [FranchiseScheduleDetail.EndTime],
            fs.Name [FranchiseScheduleDetail.FranchiseSchedule.Name],
            fs.Id [FranchiseScheduleDetail.FranchiseSchedule.Id],
            fs.EventTypeId [FranchiseScheduleDetail.FranchiseSchedule.EventTypeId],
            et.Name [FranchiseScheduleDetail.FranchiseSchedule.EventType.Name],
            (
                SELECT
                    cet.ClassificationId
                FROM events.ClassificationEventTypes cet
                WHERE cet.EventTypeId = fs.EventTypeId
                FOR JSON PATH
            ) [FranchiseScheduleDetail.FranchiseSchedule.EventType.ClassificationEventTypes],
            l.Name [FranchiseScheduleDetail.FranchiseSchedule.Location.Name],
            b.Name [FranchiseScheduleDetail.FranchiseSchedule.Park.Brand.Name],
            b.UrlSlug [FranchiseScheduleDetail.FranchiseSchedule.Park.Brand.UrlSlug],
            b.Id [FranchiseScheduleDetail.FranchiseSchedule.Park.Brand.Id],
            (
				SELECT DISTINCT
					s.Id SettingId,
					ISNULL(bs.Value, s.DefaultValue) Value
				FROM dbo.Settings s
					LEFT JOIN dbo.BrandSettings bs
						ON bs.BrandId = b.Id
						AND bs.SettingId = s.Id
			FOR JSON PATH
            ) [FranchiseScheduleDetail.FranchiseSchedule.Park.Brand.BrandSettings],
            p.Id [FranchiseScheduleDetail.FranchiseSchedule.Park.Id],
            p.Name [FranchiseScheduleDetail.FranchiseSchedule.Park.Name],
            p.Permission [FranchiseScheduleDetail.FranchiseSchedule.Park.Permission],
            p.Timezone [FranchiseScheduleDetail.FranchiseSchedule.Park.Timezone],
            (
                SELECT
                    x.ExclusionTypeId,
                    x.ExclusionDate
                FROM events.FranchiseScheduleExclusions x
                WHERE fsd.Id = x.FranchiseScheduleDetailId
                    AND x.Deleted IS NULL
                FOR JSON PATH
            ) [FranchiseScheduleDetail.Exclusions],
            per.Id [Subscription.Person.Id],
            ISNULL(per.FirstName, 'Unassigned') [Subscription.Person.FirstName],
            per.LastName [Subscription.Person.LastName],
            (
                SELECT osub.OtherSubscriptionId AS Id
                FROM #otherSubs osub
                WHERE osub.PersonId = per.Id
                    AND osub.ParkId = p.Id
                    AND osub.OtherSubscriptionId <> s.Id
                FOR JSON PATH
            ) [Subscription.Person.Subscriptions],
            i.Location [Subscription.Person.PersonImage.Image.Location],
            awp.AccountWaiverId [Subscription.Person.AccountWaiverParty.AccountWaiver.Id],
            pt.ProductTypeId [Subscription.ParkProduct.ProductTemplate.ProductTypeId],
            s.SubscriptionStatusId [Subscription.SubscriptionStatusId],
            s.ExpirationDate [Subscription.ExpirationDate],
            pa.Attended [Subscription.PersonAttendance.Attended],
            er.FromDate,
            er.ToDate,
            (er.Canceled AT TIME ZONE p.Timezone) Canceled,
            er.Id,
            er.EventReservationTypeId,
            (
                SELECT ere.Date
                FROM events.EventReservationExclusions ere
                WHERE ere.EventReservationId = er.Id
                    AND ere.Deleted IS NULL
                FOR JSON PATH
            ) EventReservationExclusions
        FROM events.EventReservations er
        JOIN events.FranchiseScheduleDetails fsd
            ON fsd.Id = er.FranchiseScheduleDetailId
        JOIN acct.Subscription s
            ON er.SubscriptionId = s.Id
        LEFT JOIN prdct.ParkProduct pp
            ON s.ProductId = pp.Id
        LEFT JOIN prdct.ProductTemplate pt
            ON pp.ProductTemplateId = pt.Id
        JOIN events.FranchiseSchedules fs
            ON fsd.FranchiseScheduleId = fs.Id
        JOIN park.Park p
            ON fs.ParkId = p.Id
        JOIN dbo.Brands b
            ON p.BrandId = b.Id
        LEFT JOIN events.Locations l
            ON fs.LocationId = l.Id
        LEFT JOIN acct.Person per
            ON s.PersonId = per.Id
        LEFT JOIN acct.PersonImage pi
            ON per.Id = pi.PersonId
            AND pi.IsActive = 1
            AND pi.PersonImageTypeId = 1 /* Subscription */
        LEFT JOIN media.Image i
            ON pi.ImageId = i.Id
        LEFT JOIN events.EventTypes et
            ON fs.EventTypeId = et.Id
        LEFT JOIN acct.AccountWaiver aw
            ON s.AccountId = aw.AccountId
                AND aw.ParkId = p.Id
                AND aw.ExpirationDate > @now
        LEFT JOIN acct.AccountWaiverParty awp
            ON aw.Id = awp.AccountWaiverId
                AND awp.PersonId = per.Id
                AND awp.WaiverPartyTypeId = 200 /* CoveredPerson */
        LEFT JOIN acct.PersonAttendance pa
            ON s.Id = pa.SubscriptionId
                AND er.Id = pa.EventReservationId
                AND (pa.Attended BETWEEN @fromDate AND @toDate OR pa.Attended IS NULL)
        WHERE s.AccountId = @accountId
            AND (per.Id = @personId OR @personId IS NULL)
            AND (@fromDate BETWEEN fsd.StartDate AND ISNULL(fsd.EndDate, fsd.StartDate)
                OR @toDate BETWEEN fsd.StartDate AND ISNULL(fsd.EndDate, fsd.StartDate)
                OR (@fromDate <= fsd.StartDate AND @toDate >= ISNULL(fsd.EndDate, fsd.StartDate)))
            AND fsd.Canceled IS NULL
            AND fsd.Deleted IS NULL
            AND fs.Deleted IS NULL
            AND fs.IsActive = 1
            AND (@onlyActivePending = 0 OR SubscriptionStatusId IN ( 100, 200, 301, 1000 )) /* Pending, Active, Used, Presale */
            AND (@onlyActivePending = 0 OR (s.ExpirationDate > (@now AT TIME ZONE p.Timezone)
            AND s.ExpirationDate > @fromDate))
            AND (@onlyActivePending = 0 OR er.Canceled IS NULL OR (er.EventReservationTypeId = 1 AND fsd.EndDate IS NOT NULL AND CONVERT(DATE, er.Canceled) > @fromDate)) /* Only check if series */
--             AND (@onlyActivePending = 0 OR NOT EXISTS ( /* Exclude if a newer reservation exists for the same subscription (transferred away) */
--                     SELECT 1
--                     FROM events.EventReservations er2
--                     WHERE er2.SubscriptionId = er.SubscriptionId
--                       AND er2.Id <> er.Id
--                       AND er2.Canceled IS NULL
--                       AND er2.FromDate IS NOT NULL
--                       AND er2.FromDate > ISNULL(er.FromDate, '1900-01-01')
--                 )
--             )
        FOR JSON PATH
    )) DATA
END
GO


